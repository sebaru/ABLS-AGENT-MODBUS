#!/bin/sh
set -eu

# Creation du groupe abls
if ! getent group abls >/dev/null 2>&1; then
  addgroup --system abls || true
fi

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true

  active_units="$(systemctl list-units --type=service --state=active 'abls-agent-modbus@*.service' --no-legend --no-pager 2>/dev/null | awk '{print $1}')"
  if [ -n "$active_units" ]; then
    for unit in $active_units; do
      systemctl try-restart "$unit" >/dev/null 2>&1 || true
    done
  fi
fi

exit 0
